{
  "model": "causal adaptive ensemble + empirical quantile reserve + day-ahead MILP + causal plan-following operation",
  "config": {
    "plan_quantile": 0.8,
    "reserve_quantile": 0.95,
    "reserve_horizon_intervals": 24,
    "residual_lookback_days": 56,
    "min_residual_days": 7,
    "reserve_shortfall_penalty": 4.0,
    "terminal_soc_target_kwh": 6000.0,
    "terminal_soc_penalty": 0.65,
    "degradation_cost_per_kwh": 0.0,
    "total_spill_penalty": 1e-07,
    "mip_relative_gap": 1e-05,
    "emergency_tolerance_kwh": 1e-06,
    "use_down_reserve": true
  },
  "data_range": [
    "2025-01-01",
    "2025-12-31"
  ],
  "output_range": [
    "2025-02-01",
    "2025-12-31"
  ],
  "right_endpoint_rule": "0:10 means 0:00-0:10",
  "template_rotation": "[point 2, ..., point 144, point 1]",
  "units": {
    "source_power": "kW",
    "decision_energy": "kWh",
    "dt_hours": 0.16666666666666666
  },
  "cost_rule": "planned purchase is billed by planned quantity; emergency price is 5x",
  "cold_start": "Attachment 1 load/PV profiles are used as prior; January is causal warm-up",
  "output_files": [
    "result2_filled.xlsx",
    "q2_timeseries.csv",
    "q2_daily_summary.csv",
    "q2_forecast_weights.csv",
    "q2_emergency_events.csv"
  ]
}